{
  "version": "1.0.0",
  "description": "Namespace Enforcement Rules Configuration",
  "principles": {
    "consistency": "同一目录下使用统一的命名风格",
    "readability": "文件名应清晰表达内容，避免无意义缩写",
    "machine_friendly": "使用小写字母和连字符，避免空格和特殊字符",
    "vcs_friendly": "避免文件名变更导致的版本历史断裂"
  },
  "global_impact": {
    "file_retrieval": {
      "description": "命名规范对文件检索效率的影响",
      "factors": [
        {
          "factor": "前缀一致性",
          "impact": "高",
          "description": "统一前缀允许使用通配符快速筛选，如 skill-* 可快速定位所有技能文件"
        },
        {
          "factor": "连字符分隔",
          "impact": "高", 
          "description": "使用连字符而非空格，避免shell转义问题，支持直接tab补全"
        },
        {
          "factor": "小写规范",
          "impact": "中",
          "description": "统一小写避免大小写敏感系统的检索遗漏"
        },
        {
          "factor": "语义化命名",
          "impact": "高",
          "description": "描述性名称支持模糊搜索和记忆检索"
        },
        {
          "factor": "版本标识",
          "impact": "中",
          "description": "版本号规范便于追踪文件演进历史"
        }
      ],
      "metrics": {
        "search_time_reduction": "30-50%",
        "autocomplete_accuracy": "提升60%",
        "retrieval_error_rate": "降低80%"
      }
    }
  },
  "rules": {
    "characters": {
      "allowed": "a-z0-9-_.",
      "forbidden": "!@#$%^&*()=+[]{}|;:'\",<>?/\\",
      "space_replacement": "-",
      "case": "lowercase_only"
    },
    "structure": {
      "pattern": "^{type}-{name}(-{qualifier})?\\.{ext}$",
      "max_length": 100,
      "min_length": 3
    },
    "types": {
      "skill": {
        "pattern": "^skill-[a-z0-9-]+\\.md$",
        "examples": ["skill-namespace-enforcement.md", "skill-daily-report.md"],
        "directory": "skills/"
      },
      "script": {
        "pattern": "^[a-z0-9-]+\\.(py|sh|js)$",
        "examples": ["namespace-checker.py", "baseline-checker.sh"],
        "directory": "scripts/"
      },
      "config": {
        "pattern": "^[a-z0-9-]+\\.(json|yaml|yml|toml)$",
        "examples": ["namespace-rules.json", "config.yaml"],
        "directory": "config/"
      },
      "document": {
        "pattern": "^(doc|guide|report)-[a-z0-9-]+(-\\d{8})?\\.md$",
        "examples": ["doc-naming-guidelines.md", "report-20250327.md"],
        "directory": "docs/"
      },
      "test": {
        "pattern": "^test_[a-z0-9_]+\\.py$",
        "examples": ["test_namespace_checker.py", "test_conflict_scenarios.py"],
        "directory": "tests/"
      }
    },
    "qualifiers": {
      "version": {
        "pattern": "^v\\d+$",
        "examples": ["v1", "v2", "v3"]
      },
      "date": {
        "pattern": "^\\d{8}$",
        "examples": ["20250327"]
      },
      "status": {
        "pattern": "^(draft|final|beta|rc)$",
        "examples": ["draft", "final"]
      }
    }
  },
  "enforcement": {
    "mode": "advisory",
    "strict_mode": false,
    "auto_check_on_create": true,
    "auto_suggest_fix": true,
    "legacy_migration": {
      "strategy": "gradual",
      "force_migration": false,
      "migration_notice": "存量文件不强制迁移，但建议逐步规范化",
      "excluded_patterns": [
        ".git",
        "node_modules",
        "__pycache__",
        ".openclaw/extensions"
      ]
    }
  },
  "feedback": {
    "immediate_warning": true,
    "suggest_fix": true,
    "provide_examples": true,
    "report_generation": true
  }
}
