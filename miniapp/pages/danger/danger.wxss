.container { padding: 32rpx; min-height: 100vh; }
.progress-wrap { height: 8rpx; background: #334155; border-radius: 4rpx; margin-bottom: 12rpx; }
.progress-bar { height: 100%; background: linear-gradient(90deg, #EF4444, #F59E0B); border-radius: 4rpx; transition: width 0.3s; }
.progress-text { font-size: 24rpx; color: #64748b; text-align: right; margin-bottom: 24rpx; }
.danger-badge { display: inline-block; padding: 6rpx 20rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: 600; background: rgba(239,68,68,0.2); color: #f87171; margin-bottom: 20rpx; }
.q-text { font-size: 34rpx; font-weight: 500; line-height: 1.7; margin-bottom: 32rpx; color: #f1f5f9; }
.options { display: flex; flex-direction: column; gap: 16rpx; }
.opt { background: #1e293b; border: 2rpx solid #334155; border-radius: 16rpx; padding: 28rpx; font-size: 28rpx; color: #e2e8f0; transition: all 0.15s; }
.opt-danger { border-color: #EF4444; background: rgba(239,68,68,0.1); }
.btn-row { display: flex; gap: 20rpx; margin-top: 40rpx; }
.btn { flex: 1; padding: 28rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; text-align: center; border: none; }
.btn-prev { background: #334155; color: #94a3b8; }
.btn-next { background: linear-gradient(135deg, #EF4444, #F59E0B); color: #fff; }
.btn-next[disabled] { opacity: 0.3; }
.btn-submit { background: linear-gradient(135deg, #EF4444, #F59E0B); color: #fff; }
.btn-submit[disabled] { opacity: 0.3; }

/* 结果 */
.result-page { text-align: center; }
.result-icon { font-size: 96rpx; margin: 60rpx 0 20rpx; }
.result-name { font-size: 44rpx; font-weight: 800; color: #f8fafc; margin-bottom: 24rpx; }
.result-bar-wrap { height: 16rpx; background: #334155; border-radius: 8rpx; margin: 16rpx 40rpx; overflow: hidden; }
.result-bar { height: 100%; border-radius: 8rpx; transition: width 0.8s; }
.result-score { font-size: 28rpx; color: #94a3b8; margin: 8rpx 0 24rpx; }
.result-desc { font-size: 28rpx; color: #94a3b8; line-height: 1.8; margin: 0 20rpx 32rpx; }
.result-action { background: #1e293b; border-radius: 16rpx; padding: 32rpx; margin: 0 20rpx 32rpx; text-align: left; }
.result-action-label { font-size: 26rpx; color: #fbbf24; display: block; margin-bottom: 8rpx; }
.result-action-text { font-size: 28rpx; color: #e2e8f0; line-height: 1.6; }
.result-breakdown { background: #1e293b; border-radius: 16rpx; padding: 28rpx; margin: 0 20rpx 32rpx; }
.breakdown-title { font-size: 24rpx; color: #64748b; display: block; margin-bottom: 16rpx; }
.breakdown-row { display: flex; justify-content: space-between; font-size: 26rpx; color: #94a3b8; margin: 8rpx 0; }
.btn-retake { background: #334155; color: #94a3b8; border-radius: 16rpx; font-size: 28rpx; padding: 24rpx; border: none; margin: 0 20rpx; }
