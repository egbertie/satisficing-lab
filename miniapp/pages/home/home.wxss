.hero { padding: 80rpx 40rpx 60rpx; text-align: center; background: linear-gradient(135deg, rgba(194,59,34,0.15), rgba(15,23,42,1)); }
.hero-title { font-size: 52rpx; font-weight: 800; color: #f8fafc; display: block; letter-spacing: 4rpx; }
.hero-subtitle { font-size: 28rpx; color: #64748b; display: block; margin-top: 8rpx; }
.hero-tagline { font-size: 30rpx; color: #C23B22; display: block; margin-top: 20rpx; font-weight: 300; }

.section { padding: 40rpx 32rpx; }
.card { background: #1e293b; border-radius: 20rpx; padding: 40rpx; margin-bottom: 24rpx; text-align: center; transition: all 0.15s; }
.card:active { opacity: 0.9; transform: scale(0.98); }
.card-icon { font-size: 64rpx; display: block; }
.card-title { font-size: 34rpx; font-weight: 700; color: #f8fafc; display: block; margin: 16rpx 0 8rpx; }
.card-desc { font-size: 26rpx; color: #94a3b8; display: block; margin-bottom: 20rpx; }
.card-btn { display: inline-block; padding: 16rpx 40rpx; background: linear-gradient(135deg, #C23B22, #B8860B); border-radius: 40rpx; font-size: 28rpx; color: #fff; font-weight: 600; }
.card-danger { border: 2rpx solid rgba(239,68,68,0.2); }
.card-btn-danger { background: linear-gradient(135deg, #EF4444, #F59E0B); }

.card-row { display: flex; gap: 20rpx; }
.card-sm { flex: 1; background: #1e293b; border-radius: 16rpx; padding: 32rpx 24rpx; text-align: center; }
.card-sm-icon { font-size: 48rpx; display: block; }
.card-sm-title { font-size: 28rpx; font-weight: 600; color: #f8fafc; display: block; margin: 8rpx 0; }
.card-sm-desc { font-size: 22rpx; color: #64748b; display: block; }

.footer { text-align: center; padding: 40rpx; color: #475569; font-size: 24rpx; }
.footer-countdown { display: block; margin-top: 8rpx; color: #C23B22; }
