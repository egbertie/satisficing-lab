.container { padding: 32rpx; min-height: 100vh; background: #0f172a; }
.header { text-align: center; padding: 40rpx 0 24rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #f8fafc; display: block; }
.subtitle { font-size: 26rpx; color: #94a3b8; margin-top: 8rpx; display: block; }

.radar-box { margin: 20rpx auto; width: 600rpx; height: 500rpx; }
.radar-canvas { width: 100%; height: 100%; }

.scores { margin: 32rpx 0; }
.score-row { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 0; }
.dim-name { width: 100rpx; font-size: 26rpx; font-weight: 600; }
.dim-bar-wrap { flex: 1; height: 12rpx; background: #334155; border-radius: 6rpx; overflow: hidden; }
.dim-bar { height: 100%; border-radius: 6rpx; transition: width 0.5s; }
.dim-val { font-size: 28rpx; font-weight: 700; color: #f8fafc; min-width: 50rpx; text-align: right; }
.dim-lv { font-size: 22rpx; color: #64748b; min-width: 60rpx; }

.avg-block { text-align: center; padding: 32rpx; margin: 24rpx 0; background: #1e293b; border-radius: 16rpx; }
.avg-label { display: block; font-size: 26rpx; color: #94a3b8; }
.avg-num { font-size: 72rpx; font-weight: 800; color: #C23B22; }
.avg-5 { font-size: 32rpx; color: #64748b; }

.pattern-block { background: #1e293b; border-radius: 16rpx; padding: 32rpx; margin: 24rpx 0; text-align: center; }
.pattern-icon { font-size: 56rpx; display: block; }
.pattern-name { font-size: 34rpx; font-weight: 700; color: #f8fafc; display: block; margin: 12rpx 0 8rpx; }
.pattern-desc { font-size: 26rpx; color: #94a3b8; display: block; line-height: 1.6; }
.pattern-rec { font-size: 26rpx; color: #fbbf24; display: block; margin-top: 12rpx; }

.actions { margin: 40rpx 0; }
.btn-retake { background: #334155; color: #94a3b8; border-radius: 16rpx; font-size: 28rpx; padding: 24rpx; border: none; }

.footer { text-align: center; padding: 40rpx 0; font-size: 22rpx; color: #475569; }
