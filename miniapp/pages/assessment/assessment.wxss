.container { padding: 32rpx; min-height: 100vh; }
.progress-wrap { height: 8rpx; background: #334155; border-radius: 4rpx; margin-bottom: 12rpx; }
.progress-bar { height: 100%; background: linear-gradient(90deg, #C23B22, #B8860B); border-radius: 4rpx; transition: width 0.3s; }
.progress-text { font-size: 24rpx; color: #64748b; text-align: right; margin-bottom: 24rpx; }

.dim-tag { display: inline-block; padding: 6rpx 20rpx; border-radius: 20rpx; font-size: 22rpx; font-weight: 600; margin-bottom: 20rpx; }
.dim-T { background: rgba(59,130,246,0.2); color: #60a5fa; }
.dim-D { background: rgba(16,185,129,0.2); color: #34d399; }
.dim-B { background: rgba(245,158,11,0.2); color: #fbbf24; }
.dim-X { background: rgba(239,68,68,0.2); color: #f87171; }
.dim-Z { background: rgba(139,92,246,0.2); color: #a78bfa; }
.dim-开放 { background: rgba(148,163,184,0.2); color: #94a3b8; }
.dim-收束 { background: rgba(194,59,34,0.3); color: #f87171; }

.q-text { font-size: 34rpx; font-weight: 500; line-height: 1.7; margin-bottom: 32rpx; color: #f1f5f9; }

.options { display: flex; flex-direction: column; gap: 16rpx; }
.opt { background: #1e293b; border: 2rpx solid #334155; border-radius: 16rpx; padding: 24rpx 28rpx; transition: all 0.15s; }
.opt-selected { border-color: #C23B22; background: rgba(194,59,34,0.12); }
.opt-label { font-size: 28rpx; font-weight: 600; color: #f8fafc; display: block; margin-bottom: 4rpx; }
.opt-desc { font-size: 24rpx; color: #94a3b8; }

.text-input { background: #1e293b; border: 2rpx solid #334155; border-radius: 16rpx; padding: 24rpx; font-size: 28rpx; color: #f1f5f9; width: 100%; min-height: 120rpx; }

.btn-row { display: flex; gap: 20rpx; margin-top: 40rpx; }
.btn { flex: 1; padding: 28rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; text-align: center; border: none; }
.btn-prev { background: #334155; color: #94a3b8; }
.btn-next { background: linear-gradient(135deg, #C23B22, #B8860B); color: #fff; }
.btn-next[disabled] { opacity: 0.3; }
.btn-submit { background: linear-gradient(135deg, #C23B22, #B8860B); color: #fff; }
.btn-submit[disabled] { opacity: 0.3; }

.scale-bar { text-align: center; padding: 32rpx; font-size: 22rpx; color: #475569; display: flex; gap: 16rpx; justify-content: center; }
.scale-dot { letter-spacing: 8rpx; }
